{
  "name": "tracmeds-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop wrapper for TracMeds on macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-builder --mac"
  },
  "dependencies": {
    "express": "^4.19.2",
    "razorpay": "^2.9.4",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "dotenv": "^16.4.5",
    "resend": "^3.5.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.tracmeds.desktop",
    "productName": "TracMeds",
    "files": [
      "**/*",
      "!node_modules/**",
      "!dist/**"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "icon": "icon.png"
    }
  }
}
