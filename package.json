{
  "name": "tracmeds-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop wrapper for TracMeds on macOS",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.tracmeds.desktop",
    "productName": "TracMeds",
    "files": [
      "**/*",
      "!node_modules/**",
      "!dist/**"
    ],
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "icon": "icon.png"
    }
  }
}
